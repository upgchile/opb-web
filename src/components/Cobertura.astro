---
// Cobertura Section - OPB Landing
---

<section id="cobertura">
  <div class="wrap coverage-grid">
    <div class="rv">
      <div class="eyebrow light">Cobertura global</div>
      <h2>Chile conectado con los principales mercados</h2>
      <p>Operamos desde los principales puertos chilenos hacia Europa, Asia, Norteamérica, Latinoamérica, Oriente Medio y África, con acuerdos y coordinación directa con navieras internacionales.</p>
      <div class="coverage-tags"><span><i class="fa-solid fa-earth-europe"></i> Europa</span><span><i class="fa-solid fa-earth-asia"></i> Asia-Pacífico</span><span><i class="fa-solid fa-earth-americas"></i> Norteamérica</span><span><i class="fa-solid fa-earth-americas"></i> Latinoamérica</span><span><i class="fa-solid fa-earth-africa"></i> Oriente Medio</span><span><i class="fa-solid fa-globe"></i> África</span></div>
    </div>
    <div class="rv d2">
      <!-- Marquee para Desktop -->
      <div class="marquee-container">
        <div class="marquee-track">
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>HAPAG-LLOYD</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>CMA CGM</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>COSCO</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>MSC</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>ONE LINE</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>+45 más</strong><span>Red global</span></div></div>
          <!-- Duplicate for seamless loop -->
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>HAPAG-LLOYD</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>CMA CGM</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>COSCO</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>MSC</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>ONE LINE</strong><span>Acuerdo directo</span></div></div>
          <div class="marquee-item"><div class="carrier marquee-carrier"><strong>+45 más</strong><span>Red global</span></div></div>
        </div>
      </div>
      <!-- Grid para Mobile -->
      <div class="carrier-grid">
        <div class="carrier"><strong>HAPAG-LLOYD</strong><span>Acuerdo directo</span></div>
        <div class="carrier"><strong>CMA CGM</strong><span>Acuerdo directo</span></div>
        <div class="carrier"><strong>COSCO</strong><span>Acuerdo directo</span></div>
        <div class="carrier"><strong>MSC</strong><span>Acuerdo directo</span></div>
        <div class="carrier"><strong>ONE LINE</strong><span>Acuerdo directo</span></div>
        <div class="carrier"><strong>+45 más</strong><span>Red global</span></div>
      </div>
    </div>
  </div>
</section>
