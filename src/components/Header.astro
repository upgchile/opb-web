---
// Header Navigation Component - OPB Landing
---

<nav class="topbar" id="topbar" aria-label="Navegación principal">
  <div class="nav-shell">
    <a href="#inicio" class="brand" aria-label="OPB Logistics inicio">
      <img src="/logo-opb-white.png" alt="OPB Logistics" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block'" />
      <span class="brand-fallback">OPB Logistics</span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#empresa">Empresa</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#itinerarios">Itinerarios</a></li>
      <li><a href="#proceso">Cómo trabajamos</a></li>
      <li><a href="#contacto">Contacto</a></li>
      <li><a href="/blog">Noticias</a></li>
    </ul>
    <div class="nav-actions" id="navActions">
      <a href="https://prod.opb.cl/" target="_blank" rel="noopener" class="nav-btn red"><i class="fa-solid fa-circle-nodes"></i> OPB 360°</a>
      <a href="http://opbs.opb.cl/" target="_blank" rel="noopener" class="nav-btn outline"><i class="fa-solid fa-lock"></i> Acceso Interno OPBSI</a>
      <a href="#contacto" class="nav-btn ghost"><i class="fa-solid fa-paper-plane"></i> Cotizar</a>
    </div>
  </div>
</nav>

<script>
  const topbar = document.getElementById('topbar');
  const menuToggle = document.getElementById('menuToggle');
  const navLinks = document.querySelectorAll('.nav-links a');

  function handleScroll() {
    topbar.classList.toggle('scrolled', window.scrollY > 24);
    const sections = [...document.querySelectorAll('section[id], #cobertura')];
    const pos = window.scrollY + 120;
    sections.forEach(sec => {
      if (pos >= sec.offsetTop && pos < sec.offsetTop + sec.offsetHeight) {
        navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + sec.id));
      }
    });
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  menuToggle.addEventListener('click', () => {
    const open = topbar.classList.toggle('menu-open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  navLinks.forEach(a => a.addEventListener('click', () => {
    topbar.classList.remove('menu-open');
    menuToggle.setAttribute('aria-expanded', 'false');
  }));
</script>
