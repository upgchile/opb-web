<!-- WhatsApp FAB — círculo en mobile, pill en desktop, halo + punto "en línea" + tooltip -->
<div id="whatsapp-wrap" class="wa-wrap">
  <a
    id="whatsapp-fab"
    href="https://wa.me/56228846709?text=Hola%20OPB%2C%20quiero%20cotizar%20un%20embarque."
    target="_blank"
    rel="noopener noreferrer"
    class="wa-fab"
    aria-label="Escríbenos por WhatsApp"
  >
    <!-- Punto "en línea" -->
    <span class="wa-status" aria-hidden="true"></span>

    <!-- Logo oficial de WhatsApp (Simple Icons) -->
    <svg class="wa-logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.57-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"
      ></path>
    </svg>
    <span class="wa-label">Escríbenos</span>
  </a>

  <!-- Tooltip (solo desktop, al hover) -->
  <span class="wa-tip" aria-hidden="true">Respondemos al instante</span>
</div>

<style>
  .wa-wrap {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
  }

  .wa-fab {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 58px;
    height: 58px;
    padding: 0;
    border-radius: 999px;
    background: var(--color-whatsapp, #25d366);
    color: #fff;
    font-family: var(--font-inter, "Inter", sans-serif);
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.4), 0 4px 10px rgba(6, 27, 56, 0.18);
    /* Estado oculto (antes del scroll) */
    opacity: 0;
    transform: translateY(16px) scale(0.8);
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.25s ease,
      width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wa-fab.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .wa-fab:hover {
    background: var(--color-whatsapp-dark, #128c7e);
  }

  .wa-logo {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .wa-label {
    display: none;
    white-space: nowrap;
  }

  /* Desktop: pasa a pill con texto */
  @media (min-width: 640px) {
    .wa-fab {
      width: auto;
      height: auto;
      padding: 0.85rem 1.3rem 0.85rem 1.1rem;
    }
    .wa-label {
      display: inline;
    }
  }

  /* Halo pulsante en ::after — NO pisa la sombra de elevación del botón */
  .wa-fab::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }
  .wa-fab.is-visible::after {
    animation: wa-halo 2.4s ease-out infinite;
  }
  @keyframes wa-halo {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  /* Punto "en línea" con ping */
  .wa-status {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 13px;
    height: 13px;
    border-radius: 999px;
    background: #4ade80;
    border: 2.5px solid #fff;
  }
  .wa-status::before {
    content: "";
    position: absolute;
    inset: -2.5px;
    border-radius: 999px;
    background: #4ade80;
    opacity: 0.75;
  }
  .wa-fab.is-visible .wa-status::before {
    animation: wa-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes wa-ping {
    75%,
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  /* Tooltip (desktop) */
  .wa-tip {
    position: absolute;
    right: calc(100% + 14px);
    top: 50%;
    white-space: nowrap;
    background: #fff;
    color: #0a1628;
    font-family: var(--font-inter, "Inter", sans-serif);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.55rem 0.85rem;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(6, 27, 56, 0.2);
    opacity: 0;
    transform: translateY(-50%) translateX(10px);
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wa-tip::after {
    content: "";
    position: absolute;
    right: -5px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: #fff;
  }
  @media (min-width: 640px) {
    .wa-wrap:hover .wa-tip {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }

  /* Accesibilidad: cero movimiento si el usuario lo pide */
  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      transition: opacity 0.3s ease;
      transform: none;
    }
    .wa-fab.is-visible::after,
    .wa-fab.is-visible .wa-status::before {
      animation: none;
    }
  }
</style>

<script>
  const fab = document.getElementById("whatsapp-fab");

  function updateFAB() {
    if (!fab) return;
    // Aparece tras pasar el 60% del primer viewport
    if (window.scrollY > window.innerHeight * 0.6) {
      fab.classList.add("is-visible");
    } else {
      fab.classList.remove("is-visible");
    }
  }

  window.addEventListener("scroll", updateFAB, { passive: true });
  updateFAB();
</script>
