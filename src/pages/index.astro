---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Empresa from "@/components/Empresa.astro";
import Estrategia from "@/components/Estrategia.astro";
import Servicios from "@/components/Servicios.astro";
import Itinerarios from "@/components/Itinerarios.astro";
import Plataforma from "@/components/Plataforma.astro";
import Proceso from "@/components/Proceso.astro";
import Diferenciadores from "@/components/Diferenciadores.astro";
import Cobertura from "@/components/Cobertura.astro";
import Contacto from "@/components/Contacto.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFAB from "@/components/WhatsAppFAB.astro";
---

<Layout>
