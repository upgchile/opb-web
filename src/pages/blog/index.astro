---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";

// Trae las noticias publicadas (excluye borradores) ordenadas por fecha desc.
const noticias = (await getCollection("noticias", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmtFecha = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Layout
  title="Noticias | OPB Logistics"
  description="Novedades, rutas y balances de temporada de OPB Logistics."
>
  <Header />
  <main class="pt-28 pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Encabezado -->
      <div class="text-center mb-14 lg:mb-20">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue/5 border border-blue/10 mb-6"
        >
          <span class="w-2 h-2 bg-blue rounded-full"></span>
          <span
            class="text-sm text-blue font-[family-name:var(--font-inter)] font-medium"
            >Noticias</span
          >
        </div>
        <h1
          class="text-[28px] lg:text-[40px] font-bold text-navy font-[family-name:var(--font-inter)] leading-tight mb-4"
        >
          Novedades de OPB Logistics
        </h1>
        <p
          class="text-base text-gray-500 font-[family-name:var(--font-poppins)] max-w-2xl mx-auto"
        >
          Rutas, temporadas y todo lo que pasa en nuestra operación.
        </p>
      </div>

      {
        noticias.length === 0 ? (
          <p class="text-center text-gray-400">Pronto publicaremos novedades.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {noticias.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group rounded-2xl bg-gray-50 border border-gray-100 overflow-hidden transition-all duration-300 hover:bg-white hover:border-gray-200 hover:shadow-xl hover:shadow-gray-200/50"
              >
                {post.data.image && (
                  <div class="aspect-[16/9] overflow-hidden">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-6">
                  <time
                    class="text-xs text-blue font-[family-name:var(--font-inter)] font-medium"
                    datetime={post.data.date.toISOString()}
                  >
                    {fmtFecha(post.data.date)}
                  </time>
                  <h2 class="text-lg font-semibold text-navy font-[family-name:var(--font-inter)] mt-2 mb-2 leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-gray-500 leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>
                  <span class="inline-flex items-center gap-1 text-sm text-blue font-[family-name:var(--font-inter)] font-medium mt-4 group-hover:gap-2 transition-all">
                    Leer más
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>
