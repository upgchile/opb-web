---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const noticias = await getCollection("noticias", ({ data }) => !data.draft);
  return noticias.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtFecha = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${post.data.title} | OPB Logistics`} description={post.data.description}>
  <Header />
  <main class="pt-28 pb-20 lg:pb-28">
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm text-blue font-[family-name:var(--font-inter)] font-medium mb-8 hover:gap-2 transition-all"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Volver a Noticias
      </a>

      <time
        class="text-sm text-blue font-[family-name:var(--font-inter)] font-medium"
        datetime={post.data.date.toISOString()}
      >
        {fmtFecha(post.data.date)}
      </time>
      <h1
        class="text-[28px] lg:text-[38px] font-bold text-navy font-[family-name:var(--font-inter)] leading-tight mt-2 mb-6"
      >
        {post.data.title}
      </h1>

      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full aspect-[16/9] object-cover rounded-2xl mb-10"
          />
        )
      }

      <div
        class="prose-opb font-[family-name:var(--font-poppins)] text-gray-700 leading-relaxed"
      >
        <Content />
      </div>

      {
        post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-gray-100">
            {post.data.tags.map((tag) => (
              <span class="text-xs px-3 py-1 rounded-full bg-blue/5 text-blue font-[family-name:var(--font-inter)]">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Estilos del cuerpo de la noticia (Markdown renderizado) */
  .prose-opb h2 {
    font-family: var(--font-inter);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-opb p {
    margin-bottom: 1rem;
  }
  .prose-opb ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose-opb li {
    margin-bottom: 0.25rem;
  }
  .prose-opb a {
    color: var(--color-blue);
    text-decoration: underline;
  }
  .prose-opb strong {
    color: var(--color-navy);
    font-weight: 600;
  }
</style>
